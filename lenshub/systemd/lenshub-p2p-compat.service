[Unit]
Description=LensHub P2P compatibility skeleton
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lenshub-p2p
Group=lenshub-p2p
WorkingDirectory=/opt/lenshub-p2p-vendor-compat
ExecStart=/opt/lenshub-p2p-vendor-compat/bin/lenshub-p2p-compat -config /opt/lenshub-p2p-vendor-compat/config/runtime.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lenshub-p2p-vendor-compat
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
